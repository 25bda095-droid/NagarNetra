# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (used for the Google sign-in redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS, never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini (Google AI Studio). Model names are set here so they can change without code changes.
GEMINI_API_KEY=
GEMINI_MODEL_ANALYZE=
GEMINI_MODEL_VERIFY=

# Groq (fallback vision + Whisper speech-to-text)
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenStreetMap services (comma-separated Overpass instances: primary first, then backups)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim requires an identifying User-Agent with a contact
OSM_USER_AGENT="NagarNetra/0.1 (contact: <your-email>)"
