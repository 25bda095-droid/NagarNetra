# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (used for the Google sign-in redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Privacy Policy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS, never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini (Google AI Studio). One key per environment: your dev key in .env.local,
# the production key only in Vercel. Never rotate keys from different accounts.
# Model names are set here so they can change without code changes.
GEMINI_API_KEY=
# Primary model for photo + voice analysis, and a fallback model (each model has its own quota)
GEMINI_MODEL_ANALYZE=
GEMINI_MODEL_FALLBACK=
# Model for the before/after photo check
GEMINI_MODEL_VERIFY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenStreetMap services (comma-separated Overpass instances: primary first, then backups)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim requires an identifying User-Agent with a contact
OSM_USER_AGENT="NagarNetra/0.1 (contact: <your-email>)"
